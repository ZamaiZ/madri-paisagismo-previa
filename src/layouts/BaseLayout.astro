---
import "../styles/global.css";
import { siteConfig, type JsonLd } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schema?: JsonLd | JsonLd[];
  openGraphType?: "website" | "article";
}

const {
  title,
  description,
  canonical,
  image,
  noindex,
  schema,
  openGraphType = "website",
} = Astro.props;

const pageTitle = title
  ? siteConfig.seo.titleTemplate
      .replace("{page}", title)
      .replace("{site}", siteConfig.name)
  : siteConfig.name;

const pageDescription = description ?? siteConfig.description;
const configuredSiteUrl = siteConfig.url.trim();
const canonicalUrl = canonical
  ? /^https?:\/\//i.test(canonical)
    ? canonical
    : configuredSiteUrl
      ? new URL(canonical, configuredSiteUrl).href
      : undefined
  : configuredSiteUrl
    ? new URL(Astro.url.pathname, configuredSiteUrl).href
    : undefined;

const imagePath = image ?? siteConfig.seo.defaultImage;
const socialImageUrl = imagePath
  ? /^https?:\/\//i.test(imagePath)
    ? imagePath
    : configuredSiteUrl
      ? new URL(imagePath, configuredSiteUrl).href
      : undefined
  : undefined;

const shouldNoindex = siteConfig.seo.noindex || noindex === true || !configuredSiteUrl;
const siteSchemas = Array.isArray(siteConfig.schema)
  ? siteConfig.schema
  : siteConfig.schema
    ? [siteConfig.schema]
    : [];
const pageSchemas = Array.isArray(schema)
  ? schema
  : schema
    ? [schema]
    : [];
const schemaBlocks = [...siteSchemas, ...pageSchemas];
const serializedSchemas = schemaBlocks.map((item) =>
  JSON.stringify(item).replace(/</g, "\\u003c"),
);
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>

    {
      pageDescription && (
        <meta name="description" content={pageDescription} />
      )
    }
    {
      shouldNoindex && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    {
      siteConfig.favicon && (
        <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/${siteConfig.favicon}`} />
      )
    }
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      socialImageUrl && (
        <meta property="og:image" content={socialImageUrl} />
      )
    }
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
    {
      socialImageUrl && (
        <meta name="twitter:image" content={socialImageUrl} />
      )
    }

    {
      serializedSchemas.map((serializedSchema) => (
        <script
          type="application/ld+json"
          set:html={serializedSchema}
        ></script>
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <slot />
    <script>
      if (
        "IntersectionObserver" in window &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");
        const observer = new IntersectionObserver((entries, activeObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              activeObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -5% 0px" });

        elements.forEach((element) => {
          element.classList.add("reveal-pending");
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
