---
import { siteConfig } from "../config/site";
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-main">
      <a href={`${import.meta.env.BASE_URL}/#inicio`} aria-label="Madri Paisagismo e Serviços — voltar ao início"><img src={`${import.meta.env.BASE_URL}/${siteConfig.logo}`} width="595" height="407" alt="Madri Paisagismo e Serviços" loading="lazy" /></a>
      <nav class="footer-nav" aria-label="Navegação do rodapé">
        {siteConfig.navigation.map((item) => <a href={`${import.meta.env.BASE_URL}/${item.href}`}>{item.label}</a>)}
      </nav>
      <a class="footer-phone" href={`tel:${siteConfig.contact.phone}`}>{siteConfig.contact.phoneDisplay}</a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Madri Paisagismo e Serviços.</span>
      <span>Imagens de ambientação publicadas por Corredo e Garcia.</span>
    </div>
  </div>
</footer>
